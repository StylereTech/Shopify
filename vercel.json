{
  "framework": "vite",
  "buildCommand": "cd frontend && npm ci && npm run build",
  "outputDirectory": "frontend/dist",
  "redirects": [
    { "source": "/", "destination": "/shopify/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/shopify/assets/:path*", "destination": "/assets/:path*" },
    { "source": "/shopify/favicon.png", "destination": "/favicon.png" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
