{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm run build && cp -r src/infrastructure/db/migrations dist/infrastructure/db/migrations"
  },
  "deploy": {
    "preDeployCommand": "node dist/infrastructure/db/migrate.js",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
